{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metaagent/task-manifest/3.0.0",
  "title": "MetaAgent Task Manifest",
  "description": "Schema for .agent/tasks/manifest.json — the global task manifest",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "Session ID that created this manifest"
    },
    "goal": {
      "type": "string",
      "description": "Overall goal of the session"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of creation"
    },
    "tasks": {
      "type": "array",
      "description": "List of tasks",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(T[0-9]+|T-INV-[0-9]+)$",
            "description": "Unique task identifier (T1, T2, ... or T-INV-N for invariants)"
          },
          "title": {
            "type": "string",
            "description": "Task title"
          },
          "description": {
            "type": "string",
            "description": "Detailed description"
          },
          "type": {
            "type": "string",
            "enum": [
              "feature",
              "refactor",
              "test",
              "fix",
              "config",
              "design",
              "docs",
              "documentation",
              "deploy",
              "implementation",
              "decision",
              "verify",
              "security",
              "investigation",
              "review",
              "upstream",
              "question",
              "housekeeping"
            ],
            "description": "Task type"
          },
          "origin": {
            "type": "string",
            "description": "Task source (roadmap:file, adr:NNN, user:direct, agent:analysis, decomposition, invariant:NNN, risk:R-NNN)"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Files affected by this task"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Task IDs this task depends on"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Measurable criteria for completion"
          },
          "context": {
            "type": "string",
            "description": "Additional context or references"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "failed",
              "archived"
            ],
            "description": "Current task status"
          },
          "claimed_by": {
            "type": "string",
            "description": "Worker ID if claimed"
          },
          "claimed_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the task was claimed"
          },
          "priority": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "fixes": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "adr": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "completed_in_commits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verified_at": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "verified": {
            "type": [
              "boolean",
              "string"
            ]
          },
          "fix_landed": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "next_action_required": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "machine_id": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "warning": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "patch_summary": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "moot_after": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "completed_in_session": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "verified_at_host": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "secret_ref": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ],
            "description": "Project extension field (documented in AGENTS.md / manifest.md)"
          },
          "verify_after_deploy": {
            "type": [
              "string",
              "boolean",
              "array",
              "object",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "metaagent_version": {
      "type": "string"
    },
    "target_repo": {
      "type": "string"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "existing",
        "greenfield",
        "scaffold"
      ]
    },
    "date": {
      "type": "string"
    },
    "phases": {
      "type": "object",
      "description": "Phase state mirror (checkpoints.json is authoritative)",
      "additionalProperties": {
        "type": "string"
      }
    },
    "backlog_count": {
      "type": "integer"
    },
    "backlog_count_breakdown": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "backlog_note": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "version",
    "tasks"
  ],
  "additionalProperties": false
}
