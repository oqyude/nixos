{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metaagent/decisions-index/3.0.0",
  "title": "MetaAgent Decisions Index",
  "description": "Schema for .agent/decisions/index.json — machine-readable index of ADRs",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version (3.0 in v3.0+, 2.0 still valid from v2.1)",
      "enum": [
        "2.0",
        "3.0",
        "3.0.0"
      ]
    },
    "decisions": {
      "type": "array",
      "description": "List of architecture decision records",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{3,}$",
            "description": "ADR number (001, 002, ...)"
          },
          "title": {
            "type": "string",
            "description": "Short title of the decision"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "deprecated",
              "superseded"
            ],
            "description": "ADR status"
          },
          "file": {
            "type": "string",
            "description": "Filename in .agent/decisions/ (e.g. 001-stack.md)"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Decision date (ISO 8601)"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Free-form tags"
          },
          "task": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ]
          },
          "resolution": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ]
          },
          "moot_unless": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ]
          },
          "resolved_at": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ]
          },
          "related_artifact": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ]
          },
          "supersedes_wrong_conclusion_of": {
            "type": [
              "string",
              "array",
              "boolean",
              "object",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "file"
        ],
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of index creation"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "proposals": {
      "type": "array",
      "description": "Proposed ADRs not yet accepted (T38+ series)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "withdrawn",
              "rejected"
            ]
          },
          "date": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "task": {
            "type": "string"
          },
          "blocked_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolution": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "decisions"
  ],
  "additionalProperties": false
}
