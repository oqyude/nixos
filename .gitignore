.vscode
.omo
__pycache__
# Anchored on purpose: the unanchored pattern matched any directory named
# `scripts` at any depth, so a future modules/*/scripts/ would have been
# silently ignored. Only the repo-root debris dir is meant here.
/scripts/
.temp
.opencode/
# H_fix.* regression session debris (helper scripts + in-place edit backups).
# These are produced by ad-hoc test scripts during a regression cycle
# and add noise to git status afterwards.
h-fix-*-helpers/
*.bak-t*

# metaagent runtime artifacts (per-session, not for commit)
.metaagent-director/
